---
interface Props {
  lang?: 'en' | 'vi';
}

const { lang = 'en' } = Astro.props;
---

<div id="sp-password-gate" class="fixed inset-0 z-[9999] bg-[#0A1628] flex items-center justify-center p-6 transition-opacity duration-500">
  <div class="max-w-md w-full bg-[#0F1E36] border border-[#C5A55A]/30 rounded-2xl p-8 md:p-10 shadow-2xl text-center relative overflow-hidden">
    <!-- Subtle gold accent line -->
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#C5A55A] to-transparent"></div>

    <!-- Mini Modal Language Toggle -->
    <div class="absolute top-4 right-4 flex items-center gap-1 border border-white/15 rounded-full p-0.5 text-[10px] font-sans">
      <button 
        type="button" 
        id="gate-lang-en" 
        class="px-2 py-0.5 rounded-full transition-all cursor-pointer text-white opacity-60 hover:opacity-100"
      >
        EN
      </button>
      <span class="text-white/20 select-none">|</span>
      <button 
        type="button" 
        id="gate-lang-vi" 
        class="px-2 py-0.5 rounded-full transition-all cursor-pointer text-white opacity-60 hover:opacity-100"
      >
        VI
      </button>
    </div>

    <!-- Monogram / Lock Icon -->
    <div class="w-16 h-16 rounded-full border border-[#C5A55A]/40 bg-[#0A1628] flex items-center justify-center mx-auto mb-6 shadow-inner">
      <svg class="w-8 h-8 text-[#C5A55A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
    </div>

    <h2 class="font-serif text-2xl md:text-3xl text-white font-semibold mb-2">S-Partners</h2>
    <p class="text-[#C5A55A] font-serif italic text-sm mb-6">Precision. Privacy. Performance.</p>

    <div class="h-px w-24 bg-[#C5A55A]/20 mx-auto mb-6"></div>

    <p id="sp-gate-desc" class="font-sans text-gray-300 text-sm leading-relaxed mb-6">
      {lang === 'en' 
        ? 'This website is currently in private preview. Please enter the access password.' 
        : 'Website đang trong giai đoạn duyệt nội bộ. Vui lòng nhập mật khẩu truy cập.'}
    </p>

    <form id="sp-gate-form" class="space-y-4">
      <div>
        <input 
          type="password" 
          id="sp-gate-input"
          placeholder={lang === 'en' ? 'Enter password...' : 'Nhập mật khẩu...'}
          autocomplete="current-password"
          class="w-full px-4 py-3 bg-[#0A1628] border border-[#C5A55A]/40 rounded-lg text-white font-sans text-sm focus:outline-none focus:border-[#C5A55A] focus:ring-1 focus:ring-[#C5A55A] transition-all text-center placeholder-gray-500"
          required
        />
      </div>

      <p id="sp-gate-error" class="text-rose-400 text-xs font-sans hidden">
        {lang === 'en' ? 'Incorrect password. Please try again.' : 'Mật khẩu không đúng. Vui lòng thử lại.'}
      </p>

      <button 
        type="submit"
        id="sp-gate-submit"
        class="w-full py-3 bg-[#C5A55A] hover:bg-[#b0934e] text-[#0A1628] font-sans text-xs uppercase tracking-widest font-semibold rounded-lg transition-all duration-200 cursor-pointer shadow-md"
      >
        {lang === 'en' ? 'Unlock Access' : 'Mở khóa truy cập'}
      </button>
    </form>

    <p class="mt-8 text-[11px] text-gray-500 font-sans">
      &copy; 2026 S-Partners Advisory Company
    </p>
  </div>
</div>

<script define:vars={{ initialLang: lang }}>
  (function() {
    const VALID_PASSWORDS = ['SPAdvisory2026', 'SP@2026', 'spadvisory', 'SP2026'];
    const AUTH_KEY = 'sp_preview_auth_v1';

    let currentGateLang = initialLang || 'en';

    const translations = {
      en: {
        desc: 'This website is currently in private preview. Please enter the access password.',
        placeholder: 'Enter password...',
        submit: 'Unlock Access',
        error: 'Incorrect password. Please try again.'
      },
      vi: {
        desc: 'Website đang trong giai đoạn duyệt nội bộ. Vui lòng nhập mật khẩu truy cập.',
        placeholder: 'Nhập mật khẩu...',
        submit: 'Mở khóa truy cập',
        error: 'Mật khẩu không đúng. Vui lòng thử lại.'
      }
    };

    function updateGateTexts(l) {
      currentGateLang = l;
      const desc = document.getElementById('sp-gate-desc');
      const input = document.getElementById('sp-gate-input');
      const submit = document.getElementById('sp-gate-submit');
      const error = document.getElementById('sp-gate-error');
      const btnEn = document.getElementById('gate-lang-en');
      const btnVi = document.getElementById('gate-lang-vi');

      if (desc) desc.textContent = translations[l].desc;
      if (input) input.placeholder = translations[l].placeholder;
      if (submit) submit.textContent = translations[l].submit;
      if (error && !error.classList.contains('hidden')) error.textContent = translations[l].error;

      if (btnEn && btnVi) {
        if (l === 'en') {
          btnEn.className = 'px-2 py-0.5 rounded-full bg-[#C5A55A] text-[#0A1628] font-semibold opacity-100';
          btnVi.className = 'px-2 py-0.5 rounded-full text-white opacity-60 hover:opacity-100';
        } else {
          btnVi.className = 'px-2 py-0.5 rounded-full bg-[#C5A55A] text-[#0A1628] font-semibold opacity-100';
          btnEn.className = 'px-2 py-0.5 rounded-full text-white opacity-60 hover:opacity-100';
        }
      }
    }

    function checkAuth() {
      const isAuth = localStorage.getItem(AUTH_KEY) === 'true';
      const gate = document.getElementById('sp-password-gate');
      if (isAuth && gate) {
        gate.style.display = 'none';
        document.body.style.overflow = '';
      } else if (gate) {
        gate.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    }

    // Check immediately
    checkAuth();

    document.addEventListener('DOMContentLoaded', () => {
      checkAuth();
      updateGateTexts(currentGateLang);

      const form = document.getElementById('sp-gate-form');
      const input = document.getElementById('sp-gate-input');
      const errorMsg = document.getElementById('sp-gate-error');
      const gate = document.getElementById('sp-password-gate');
      const btnEn = document.getElementById('gate-lang-en');
      const btnVi = document.getElementById('gate-lang-vi');

      btnEn?.addEventListener('click', () => updateGateTexts('en'));
      btnVi?.addEventListener('click', () => updateGateTexts('vi'));

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const entered = (input?.value || '').trim();

        if (VALID_PASSWORDS.includes(entered)) {
          localStorage.setItem(AUTH_KEY, 'true');
          errorMsg?.classList.add('hidden');
          
          if (gate) {
            gate.style.opacity = '0';
            setTimeout(() => {
              gate.style.display = 'none';
              document.body.style.overflow = '';
            }, 300);
          }
        } else {
          errorMsg?.classList.remove('hidden');
          if (errorMsg) errorMsg.textContent = translations[currentGateLang].error;
          input?.classList.add('border-rose-400');
          input?.focus();
        }
      });
    });
  })();
</script>
