---
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  date: Date;
  description: string;
  type: 'weekly' | 'deep-dive';
  slug: string;
}

const { title, date, description, type, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('vi-VN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const typeBadge = type === 'weekly'
  ? { label: 'Hàng tuần', borderColor: 'border-[#C5A55A] text-[#C5A55A]' }
  : { label: 'Chuyên sâu', borderColor: 'border-[#0A1628] text-[#0A1628]' };
---

<a
  href={`/ban-tin/${slug}`}
  class="group block border border-[#0A1628]/10 p-8 transition-all duration-300 hover:shadow-md hover:-translate-y-0.5"
>
  <div class="flex items-center gap-3 mb-4">
    <time class="text-sm text-[#6B7280] font-sans">{formattedDate}</time>
    <span class={`text-[11px] uppercase tracking-[0.08em] font-sans font-medium px-3 py-1 border rounded-full ${typeBadge.borderColor}`}>
      {typeBadge.label}
    </span>
  </div>

  <h3 class="font-serif text-xl md:text-2xl text-[#0A1628] mb-3 group-hover:text-[#1B2A4A] transition-colors">
    {title}
  </h3>

  <p class="text-[#6B7280] font-sans text-base leading-relaxed line-clamp-2">
    {description}
  </p>

  <div class="mt-6 flex items-center gap-2 text-[#0A1628] text-sm font-sans uppercase tracking-[0.05em] opacity-0 group-hover:opacity-100 transition-opacity duration-300">
    Đọc tiếp
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </div>
</a>
