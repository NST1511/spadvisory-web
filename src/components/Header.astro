---
interface Props {
  transparent?: boolean;
  lang?: 'vi' | 'en';
}

const { transparent = true, lang = 'vi' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Nav links based on language
const navItems = lang === 'vi' 
  ? [
      { label: 'Trang chủ', href: '/' },
      { label: 'Dịch vụ', href: '/dich-vu' },
      { label: 'Về chúng tôi', href: '/ve-chung-toi' },
      { label: 'Bản tin', href: '/ban-tin' },
      { label: 'Liên hệ', href: '/lien-he' },
    ]
  : [
      { label: 'Home', href: '/en' },
      { label: 'Services', href: '/en/services' },
      { label: 'About Us', href: '/en/about-us' },
      { label: 'News', href: '/en/news' },
      { label: 'Contact', href: '/en/contact' },
    ];

// Compute corresponding counterpart URL for language switcher
let viUrl = '/';
let enUrl = '/en';

if (lang === 'vi') {
  if (currentPath === '/' || currentPath === '') enUrl = '/en';
  else if (currentPath.startsWith('/dich-vu')) enUrl = '/en/services';
  else if (currentPath.startsWith('/ve-chung-toi')) enUrl = '/en/about-us';
  else if (currentPath.startsWith('/ban-tin/')) enUrl = currentPath.replace('/ban-tin/', '/en/news/');
  else if (currentPath.startsWith('/ban-tin')) enUrl = '/en/news';
  else if (currentPath.startsWith('/lien-he')) enUrl = '/en/contact';
  else enUrl = '/en';
  viUrl = currentPath;
} else {
  if (currentPath === '/en' || currentPath === '/en/') viUrl = '/';
  else if (currentPath.startsWith('/en/services')) viUrl = '/dich-vu';
  else if (currentPath.startsWith('/en/about-us')) viUrl = '/ve-chung-toi';
  else if (currentPath.startsWith('/en/news/')) viUrl = currentPath.replace('/en/news/', '/ban-tin/');
  else if (currentPath.startsWith('/en/news')) viUrl = '/ban-tin';
  else if (currentPath.startsWith('/en/contact')) viUrl = '/lien-he';
  else viUrl = '/';
  enUrl = currentPath;
}
---

<header 
  id="main-header" 
  class:list={[
    "fixed top-0 left-0 w-full z-50 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]",
    { "bg-transparent py-6": transparent, "bg-white shadow-sm py-4": !transparent }
  ]}
>
  <div class="container mx-auto px-4 flex justify-between items-center">
    <a href={lang === 'vi' ? '/' : '/en'} class="flex flex-col">
      <span class:list={["font-serif text-2xl font-semibold tracking-wide transition-colors duration-300", { "text-white": transparent, "text-navy": !transparent }]} id="logo-text">S-Partners</span>
      <span class="font-sans text-[10px] uppercase tracking-widest text-gray-500">Advisory Company</span>
    </a>

    <!-- Desktop Nav & Language Dropdown -->
    <div class="hidden md:flex items-center space-x-8">
      <nav class="flex space-x-8">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class:list={[
              "nav-link font-sans text-sm transition-colors duration-200 hover:text-gold",
              { "text-white": transparent, "text-navy": !transparent }
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Globe Language Dropdown (Desktop) -->
      <div class="relative" id="lang-dropdown-wrapper">
        <button 
          id="lang-dropdown-btn"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          class:list={[
            "lang-btn inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs font-sans tracking-wider transition-all duration-200 cursor-pointer",
            { 
              "border-white/30 text-white hover:border-gold hover:text-gold bg-white/5 backdrop-blur-xs": transparent, 
              "border-navy/20 text-navy hover:border-gold hover:text-gold bg-transparent": !transparent 
            }
          ]}
        >
          <!-- Globe icon -->
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="font-medium font-sans uppercase">{lang === 'vi' ? 'VI' : 'EN'}</span>
          <svg id="lang-chevron" class="w-3 h-3 transition-transform duration-200 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div 
          id="lang-dropdown-menu"
          class="hidden absolute right-0 top-full mt-2 w-48 bg-white border border-navy/10 rounded-xl shadow-xl py-2 z-50 transform origin-top-right transition-all duration-200 font-sans"
        >
          <!-- Vietnamese Option -->
          <a 
            href={viUrl}
            class:list={[
              "flex items-center justify-between px-4 py-2.5 text-sm transition-colors duration-150",
              lang === 'vi' ? "bg-gold/10 text-navy font-semibold" : "text-gray-700 hover:bg-gray-50 hover:text-gold"
            ]}
          >
            <div class="flex items-center gap-3">
              <!-- Vietnam SVG Flag -->
              <svg class="w-5 h-3.5 rounded-[2px] shadow-2xs shrink-0" viewBox="0 0 30 20" fill="none">
                <rect width="30" height="20" fill="#DA251D"/>
                <polygon points="15,4 17.35,11.24 11.2,6.76 18.8,6.76 12.65,11.24" fill="#FFFF00"/>
              </svg>
              <span>Tiếng Việt</span>
            </div>
            {lang === 'vi' && (
              <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
            )}
          </a>

          <!-- English Option -->
          <a 
            href={enUrl}
            class:list={[
              "flex items-center justify-between px-4 py-2.5 text-sm transition-colors duration-150",
              lang === 'en' ? "bg-gold/10 text-navy font-semibold" : "text-gray-700 hover:bg-gray-50 hover:text-gold"
            ]}
          >
            <div class="flex items-center gap-3">
              <!-- UK SVG Flag -->
              <svg class="w-5 h-3.5 rounded-[2px] shadow-2xs shrink-0" viewBox="0 0 60 40" fill="none">
                <rect width="60" height="40" fill="#012169"/>
                <path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="6"/>
                <path d="M0,0 L60,40 M60,0 L0,40" stroke="#C8102E" stroke-width="4"/>
                <path d="M30,0 v40 M0,20 h60" stroke="#fff" stroke-width="10"/>
                <path d="M30,0 v40 M0,20 h60" stroke="#C8102E" stroke-width="6"/>
              </svg>
              <span>English</span>
            </div>
            {lang === 'en' && (
              <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
            )}
          </a>
        </div>
      </div>
    </div>

    <!-- Mobile Header Actions -->
    <div class="md:hidden flex items-center space-x-3">
      <!-- Mobile Globe Button -->
      <div class="relative" id="lang-dropdown-mobile-wrapper">
        <button 
          id="lang-dropdown-mobile-btn"
          type="button"
          aria-expanded="false"
          aria-label="Change language"
          class:list={[
            "lang-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-xs font-sans transition-all duration-200 cursor-pointer",
            { 
              "border-white/30 text-white bg-white/5": transparent, 
              "border-navy/20 text-navy bg-transparent": !transparent 
            }
          ]}
        >
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="font-medium font-sans uppercase text-[11px]">{lang === 'vi' ? 'VI' : 'EN'}</span>
        </button>

        <!-- Mobile Dropdown Menu -->
        <div 
          id="lang-dropdown-mobile-menu"
          class="hidden absolute right-0 top-full mt-2 w-44 bg-white border border-navy/10 rounded-xl shadow-xl py-2 z-50 font-sans"
        >
          <a 
            href={viUrl}
            class:list={[
              "flex items-center justify-between px-3 py-2 text-xs",
              lang === 'vi' ? "bg-gold/10 text-navy font-semibold" : "text-gray-700 hover:bg-gray-50"
            ]}
          >
            <div class="flex items-center gap-2">
              <svg class="w-4 h-3 rounded-[2px] shrink-0" viewBox="0 0 30 20" fill="none">
                <rect width="30" height="20" fill="#DA251D"/>
                <polygon points="15,4 17.35,11.24 11.2,6.76 18.8,6.76 12.65,11.24" fill="#FFFF00"/>
              </svg>
              <span>Tiếng Việt</span>
            </div>
            {lang === 'vi' && <span class="text-gold font-bold">✓</span>}
          </a>

          <a 
            href={enUrl}
            class:list={[
              "flex items-center justify-between px-3 py-2 text-xs",
              lang === 'en' ? "bg-gold/10 text-navy font-semibold" : "text-gray-700 hover:bg-gray-50"
            ]}
          >
            <div class="flex items-center gap-2">
              <svg class="w-4 h-3 rounded-[2px] shrink-0" viewBox="0 0 60 40" fill="none">
                <rect width="60" height="40" fill="#012169"/>
                <path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="6"/>
                <path d="M0,0 L60,40 M60,0 L0,40" stroke="#C8102E" stroke-width="4"/>
                <path d="M30,0 v40 M0,20 h60" stroke="#fff" stroke-width="10"/>
                <path d="M30,0 v40 M0,20 h60" stroke="#C8102E" stroke-width="6"/>
              </svg>
              <span>English</span>
            </div>
            {lang === 'en' && <span class="text-gold font-bold">✓</span>}
          </a>
        </div>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" aria-label="Menu" class:list={["flex flex-col justify-center items-center w-8 h-8 space-y-1.5 focus:outline-none transition-colors duration-300", { "text-white": transparent, "text-navy": !transparent }]}>
        <span class="block w-6 h-0.5 bg-current transition-transform duration-300"></span>
        <span class="block w-6 h-0.5 bg-current transition-opacity duration-300"></span>
        <span class="block w-6 h-0.5 bg-current transition-transform duration-300"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer (Slide-in) -->
<div id="mobile-menu" class="fixed inset-y-0 right-0 w-64 bg-white shadow-xl transform translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] z-40 pt-20">
  <nav class="flex flex-col space-y-6 px-6 py-4">
    {navItems.map(item => (
      <a href={item.href} class="font-sans text-base text-navy hover:text-gold transition-colors duration-200">
        {item.label}
      </a>
    ))}

    <!-- Mobile Drawer Language List with Flags -->
    <div class="pt-6 border-t border-navy/10 space-y-3">
      <span class="font-sans text-xs uppercase tracking-wider text-gray-500 block mb-2">
        {lang === 'vi' ? 'Chọn ngôn ngữ' : 'Select Language'}
      </span>
      <div class="flex flex-col space-y-2">
        <a 
          href={viUrl} 
          class:list={[
            "flex items-center justify-between px-3 py-2 rounded-lg border text-xs font-sans transition-all duration-200",
            lang === 'vi' 
              ? "border-gold bg-gold/10 text-navy font-semibold" 
              : "border-gray-200 text-gray-700 hover:border-gold hover:text-gold"
          ]}
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-5 h-3.5 rounded-[2px] shadow-2xs shrink-0" viewBox="0 0 30 20" fill="none">
              <rect width="30" height="20" fill="#DA251D"/>
              <polygon points="15,4 17.35,11.24 11.2,6.76 18.8,6.76 12.65,11.24" fill="#FFFF00"/>
            </svg>
            <span>Tiếng Việt</span>
          </div>
          {lang === 'vi' && <span class="text-gold font-bold">✓</span>}
        </a>

        <a 
          href={enUrl} 
          class:list={[
            "flex items-center justify-between px-3 py-2 rounded-lg border text-xs font-sans transition-all duration-200",
            lang === 'en' 
              ? "border-gold bg-gold/10 text-navy font-semibold" 
              : "border-gray-200 text-gray-700 hover:border-gold hover:text-gold"
          ]}
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-5 h-3.5 rounded-[2px] shadow-2xs shrink-0" viewBox="0 0 60 40" fill="none">
              <rect width="60" height="40" fill="#012169"/>
              <path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="6"/>
              <path d="M0,0 L60,40 M60,0 L0,40" stroke="#C8102E" stroke-width="4"/>
              <path d="M30,0 v40 M0,20 h60" stroke="#fff" stroke-width="10"/>
              <path d="M30,0 v40 M0,20 h60" stroke="#C8102E" stroke-width="6"/>
            </svg>
            <span>English</span>
          </div>
          {lang === 'en' && <span class="text-gold font-bold">✓</span>}
        </a>
      </div>
    </div>
  </nav>
</div>

<!-- Mobile menu backdrop -->
<div id="mobile-menu-backdrop" class="fixed inset-0 bg-black/20 opacity-0 pointer-events-none transition-opacity duration-300 z-30"></div>

<script define:vars={{ initialTransparent: transparent }}>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('main-header');
    const logoText = document.getElementById('logo-text');
    const navLinks = document.querySelectorAll('.nav-link');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileBackdrop = document.getElementById('mobile-menu-backdrop');
    
    // Desktop Dropdown elements
    const desktopDropdownBtn = document.getElementById('lang-dropdown-btn');
    const desktopDropdownMenu = document.getElementById('lang-dropdown-menu');
    const desktopChevron = document.getElementById('lang-chevron');
    
    // Mobile Dropdown elements
    const mobileDropdownBtn = document.getElementById('lang-dropdown-mobile-btn');
    const mobileDropdownMenu = document.getElementById('lang-dropdown-mobile-menu');
    
    const langBtns = document.querySelectorAll('.lang-btn');

    // Toggle desktop dropdown
    let isDesktopOpen = false;
    const toggleDesktopDropdown = (e) => {
      e?.stopPropagation();
      isDesktopOpen = !isDesktopOpen;
      if (isDesktopOpen) {
        desktopDropdownMenu?.classList.remove('hidden');
        desktopChevron?.classList.add('rotate-180');
        desktopDropdownBtn?.setAttribute('aria-expanded', 'true');
        // Close mobile dropdown if open
        if (isMobileOpen) toggleMobileDropdown();
      } else {
        desktopDropdownMenu?.classList.add('hidden');
        desktopChevron?.classList.remove('rotate-180');
        desktopDropdownBtn?.setAttribute('aria-expanded', 'false');
      }
    };

    desktopDropdownBtn?.addEventListener('click', toggleDesktopDropdown);

    // Toggle mobile header dropdown
    let isMobileOpen = false;
    const toggleMobileDropdown = (e) => {
      e?.stopPropagation();
      isMobileOpen = !isMobileOpen;
      if (isMobileOpen) {
        mobileDropdownMenu?.classList.remove('hidden');
        mobileDropdownBtn?.setAttribute('aria-expanded', 'true');
        // Close desktop dropdown if open
        if (isDesktopOpen) toggleDesktopDropdown();
      } else {
        mobileDropdownMenu?.classList.add('hidden');
        mobileDropdownBtn?.setAttribute('aria-expanded', 'false');
      }
    };

    mobileDropdownBtn?.addEventListener('click', toggleMobileDropdown);

    // Close dropdowns on outside click or escape
    document.addEventListener('click', (e) => {
      if (isDesktopOpen && !desktopDropdownMenu?.contains(e.target) && !desktopDropdownBtn?.contains(e.target)) {
        toggleDesktopDropdown();
      }
      if (isMobileOpen && !mobileDropdownMenu?.contains(e.target) && !mobileDropdownBtn?.contains(e.target)) {
        toggleMobileDropdown();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (isDesktopOpen) toggleDesktopDropdown();
        if (isMobileOpen) toggleMobileDropdown();
      }
    });

    // Adjust colors based on scroll
    const updateHeaderStyle = () => {
      if (!initialTransparent) return; // Always solid
      
      if (window.scrollY > 100) {
        header.classList.remove('bg-transparent', 'py-6');
        header.classList.add('bg-white', 'shadow-sm', 'py-4');
        logoText.classList.remove('text-white');
        logoText.classList.add('text-navy');
        navLinks.forEach(link => {
          link.classList.remove('text-white');
          link.classList.add('text-navy');
        });
        mobileBtn.classList.remove('text-white');
        mobileBtn.classList.add('text-navy');
        
        langBtns.forEach(btn => {
          btn.classList.remove('border-white/30', 'text-white', 'bg-white/5');
          btn.classList.add('border-navy/20', 'text-navy', 'bg-transparent');
        });
      } else {
        header.classList.add('bg-transparent', 'py-6');
        header.classList.remove('bg-white', 'shadow-sm', 'py-4');
        logoText.classList.add('text-white');
        logoText.classList.remove('text-navy');
        navLinks.forEach(link => {
          link.classList.add('text-white');
          link.classList.remove('text-navy');
        });
        mobileBtn.classList.add('text-white');
        mobileBtn.classList.remove('text-navy');
        
        langBtns.forEach(btn => {
          btn.classList.add('border-white/30', 'text-white', 'bg-white/5');
          btn.classList.remove('border-navy/20', 'text-navy', 'bg-transparent');
        });
      }
    };

    // Scroll listener
    window.addEventListener('scroll', updateHeaderStyle, { passive: true });

    // Mobile menu drawer toggle
    let isMenuOpen = false;
    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;
      if (isMenuOpen) {
        mobileMenu.classList.remove('translate-x-full');
        mobileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        mobileBackdrop.classList.add('opacity-100');
        // Animate hamburger to X
        const spans = mobileBtn.querySelectorAll('span');
        spans[0].style.transform = 'translateY(8px) rotate(45deg)';
        spans[1].style.opacity = '0';
        spans[2].style.transform = 'translateY(-8px) rotate(-45deg)';
      } else {
        mobileMenu.classList.add('translate-x-full');
        mobileBackdrop.classList.remove('opacity-100');
        mobileBackdrop.classList.add('opacity-0', 'pointer-events-none');
        // Revert hamburger
        const spans = mobileBtn.querySelectorAll('span');
        spans[0].style.transform = 'none';
        spans[1].style.opacity = '1';
        spans[2].style.transform = 'none';
      }
    };

    mobileBtn.addEventListener('click', toggleMenu);
    mobileBackdrop.addEventListener('click', toggleMenu);

    // Auto-close menu on link click
    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => { if (isMenuOpen) toggleMenu(); });
    });
  });
</script>
