---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Dịch vụ tư vấn - SP Advisory" description="Các giải pháp tư vấn chuyên sâu về tài chính doanh nghiệp, giao dịch M&A, định giá và tư vấn thuế." lang="vi">
  <main class="bg-[#FAFAFA] min-h-screen pt-36 pb-20">
    <div class="max-w-[1200px] mx-auto px-6 md:px-12">
      <!-- Header -->
      <header class="max-w-[800px] mb-16 animate-fade-in-up">
        <h1 class="font-serif text-5xl md:text-6xl text-[#0A1628] leading-tight mb-6">Dịch vụ Tư vấn</h1>
        <p class="font-sans text-lg text-[#0A1628]/70 leading-relaxed">
          Cung cấp các giải pháp tư vấn chuyên sâu, được thiết kế riêng biệt nhằm đáp ứng các mục tiêu chiến lược và tài chính phức tạp của doanh nghiệp.
        </p>
      </header>

      <!-- Mini-nav -->
      <nav class="mb-20 border-b border-[#0A1628]/10 pb-5">
        <ul class="flex flex-wrap gap-x-2 gap-y-2 items-center">
          <li><a href="#tai-chinh-doanh-nghiep" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Tài chính DN</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#huy-dong-von-ma" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Huy động vốn & M&A</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#dinh-gia-tham-dinh" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Định giá & Thẩm định</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#tai-cau-truc" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Tái cấu trúc</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#tu-van-thue" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Tư vấn Thuế</a></li>
        </ul>
      </nav>

      <!-- Services Clusters -->
      <div class="space-y-32">
        
        <!-- Cluster 1 -->
        <section id="tai-chinh-doanh-nghiep" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            I. Tư vấn Tài chính Doanh nghiệp (Corporate Finance Advisory)
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Tài chính Doanh nghiệp</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Chiến lược & Tối ưu nguồn vốn</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi công việc:</strong>
                  Chiến lược tài chính, cấu trúc vốn, đánh giá dự án đầu tư, quản lý vốn lưu động
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm bàn giao:</strong>
                  Báo cáo chiến lược tài chính, báo cáo rà soát sức khỏe tài chính doanh nghiệp, đề xuất cấu trúc vốn tối ưu
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Giám đốc Tài chính (CFO Advisory)</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Đồng hành điều hành</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi công việc:</strong>
                  Dịch vụ CFO thuê ngoài / CFO đồng hành, lập ngân sách, kế hoạch tài chính, quản trị dòng tiền, quản lý vốn & báo cáo quản trị
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm bàn giao:</strong>
                  Mô hình ngân sách, bộ báo cáo quản trị định kỳ, dự báo dòng tiền, quy chế tài chính
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Xây dựng Mô hình Tài chính (Financial Modelling)</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Dự báo & Phân tích kịch bản</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi công việc:</strong>
                  Mô hình tài chính 3 báo cáo tích hợp, mô hình định giá, mô hình tài chính dự án, phân tích kịch bản & độ nhạy
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm bàn giao:</strong>
                  Mô hình tài chính phục vụ gọi vốn/giao dịch, mô hình định giá, mô hình dự báo dài hạn, công cụ hỗ trợ ra quyết định đầu tư
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 2 -->
        <section id="huy-dong-von-ma" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            II. Tư vấn Huy động vốn & M&A (Fund Raising & M&A Advisory)
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-4xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Huy động vốn (Fund Raising Advisory)</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Vốn cổ phần & Vốn vay</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi công việc:</strong>
                  Huy động vốn cổ phần (Equity), huy động vốn vay (Debt), chuẩn bị doanh nghiệp trước gọi vốn, xây dựng Bản thông tin chào bán (IM), thiết kế Pitch deck, tối ưu cấu trúc gọi vốn, tiếp cận nhà đầu tư
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm bàn giao:</strong>
                  Bản thông tin chào bán (IM), Pitch deck gọi vốn chuyên nghiệp, mô hình tài chính phục vụ gọi vốn, danh sách nhà đầu tư mục tiêu, chiến lược gọi vốn
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn M&A (M&A Advisory)</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Mua bán & Sáp nhập</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi công việc:</strong>
                  Tư vấn bên mua (Buy-side), tư vấn bên bán (Sell-side), xây dựng cấu trúc giao dịch, hỗ trợ đàm phán thương mại, quản lý quy trình giao dịch
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm bàn giao:</strong>
                  Chiến lược M&A, danh sách đối tác mục tiêu, cấu trúc giao dịch đề xuất, hỗ trợ đóng giao dịch (closing)
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 3 -->
        <section id="dinh-gia-tham-dinh" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            III. Định giá & Thẩm định tài chính (Valuation & Due Diligence)
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-4xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Định giá Doanh nghiệp (Business Valuation)</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Xác định giá trị thực</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi công việc:</strong>
                  Định giá doanh nghiệp, định giá vốn chủ sở hữu, định giá dự án đầu tư, định giá phục vụ giao dịch M&A, định giá tài sản / mảng kinh doanh
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm bàn giao:</strong>
                  Báo cáo định giá độc lập, mô hình định giá chi tiết (DCF, Market Multiples, NAV)
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Thẩm định Tài chính (Financial Due Diligence - FDD)</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Rà soát chất lượng lợi nhuận</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi công việc:</strong>
                  Rà soát chất lượng lợi nhuận (Quality of Earnings - QoE), rà soát vốn lưu động, chất lượng dòng tiền, nợ thuần và các khoản tương đương nợ, nhận diện rủi ro tài chính
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm bàn giao:</strong>
                  Báo cáo FDD, danh mục phát hiện và rủi ro tài chính, bảng điều chỉnh EBITDA chuẩn hóa
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 4 -->
        <section id="tai-cau-truc" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            IV. Tái cấu trúc Doanh nghiệp (Restructuring)
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-2xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tái cấu trúc Doanh nghiệp</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Phục hồi & Tối ưu vận hành</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi công việc:</strong>
                  Tái cấu trúc tài chính, tái cơ cấu nợ, tái cấu trúc hoạt động kinh doanh, tối ưu hóa chi phí
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm bàn giao:</strong>
                  Kế hoạch tái cấu trúc tổng thể, lộ trình thực hiện, kế hoạch quản lý thanh khoản
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 5 -->
        <section id="tu-van-thue" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            V. Tư vấn Thuế (Tax Advisory)
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-2xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Thuế (Tax Advisory)</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Kế hoạch & Tuân thủ thuế</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi công việc:</strong>
                  Hoạch định thuế, soát xét tuân thủ thuế (Tax Health Check), thẩm định thuế trong giao dịch (Tax Due Diligence), cấu trúc thuế cho giao dịch
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm bàn giao:</strong>
                  Báo cáo tư vấn thuế, báo cáo phát hiện và rủi ro thuế, đề xuất cấu trúc thuế tối ưu
                </div>
              </div>
            </div>
          </div>
        </section>

      </div>
    </div>
  </main>
</BaseLayout>
