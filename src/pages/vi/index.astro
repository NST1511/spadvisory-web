---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
---

<BaseLayout 
  title="S-Partners Advisory Company" 
  description="Boutique advisory — Precision. Privacy. Performance."
  transparentHeader={true}
  lang="vi"
>
  <!-- Section 1: Hero -->
  <Hero lang="vi" />

  <!-- Section 2: Services Overview -->
  <section class="py-24 md:py-32 px-6 md:px-12 max-w-[1200px] mx-auto scroll-fade">
    <h2 class="text-center text-[#0A1628] font-serif text-2xl md:text-3xl tracking-[0.15em] mb-16">
      TAX • FINANCE • M&A
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <ServiceCard 
        title="Tư vấn Thuế"
        description="Giải pháp thuế toàn diện cho doanh nghiệp, tối ưu hóa nghĩa vụ thuế và đảm bảo tuân thủ pháp luật."
        href="/vi/dich-vu#tu-van-thue"
        lang="vi"
      />
      <ServiceCard 
        title="Tài chính Doanh nghiệp"
        description="Định giá, tái cấu trúc tài chính và tư vấn chiến lược nhằm tối đa hóa giá trị doanh nghiệp."
        href="/vi/dich-vu#tai-chinh-doanh-nghiep"
        lang="vi"
      />
      <ServiceCard 
        title="M&A"
        description="Tư vấn mua bán & sáp nhập toàn diện, từ tìm kiếm đối tác đến hoàn tất giao dịch."
        href="/vi/dich-vu#huy-dong-von-ma"
        lang="vi"
      />
    </div>
  </section>

  <!-- Section 3: Values -->
  <section class="py-24 md:py-32 px-6 md:px-12 bg-[#FAFAFA] scroll-fade">
    <div class="max-w-[1200px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-8 text-center">
        <div class="flex flex-col items-center">
          <h3 class="font-serif text-[#C5A55A] text-3xl mb-4 italic">Precision</h3>
          <p class="font-sans text-gray-600 max-w-xs mx-auto">Chính xác tuyệt đối trong từng phân tích, định giá và giải pháp.</p>
        </div>
        <div class="flex flex-col items-center">
          <h3 class="font-serif text-[#C5A55A] text-3xl mb-4 italic">Privacy</h3>
          <p class="font-sans text-gray-600 max-w-xs mx-auto">Bảo mật thông tin khách hàng và giao dịch là ưu tiên hàng đầu.</p>
        </div>
        <div class="flex flex-col items-center">
          <h3 class="font-serif text-[#C5A55A] text-3xl mb-4 italic">Performance</h3>
          <p class="font-sans text-gray-600 max-w-xs mx-auto">Cam kết mang lại kết quả thực tế, đo lường được cho mỗi dự án.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: CTA -->
  <section id="contact" class="py-32 px-6 md:px-12 text-center scroll-fade">
    <div class="max-w-[800px] mx-auto flex flex-col items-center">
      <h2 class="text-[#0A1628] font-serif text-3xl md:text-4xl mb-10">
        Đồng hành cùng sự phát triển của Doanh nghiệp
      </h2>
      <a 
        href="/vi/lien-he" 
        class="inline-block border border-[#0A1628] text-[#0A1628] uppercase text-[13px] tracking-[0.08em] px-10 py-4 transition-all duration-300 hover:bg-[#0A1628] hover:text-[#FAFAFA]"
      >
        Liên hệ với Chuyên gia
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Intersection Observer for scroll animations
  const setupObserver = () => {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll('.scroll-fade');
    elements.forEach(el => observer.observe(el));
  };

  // Run on load and after view transitions
  setupObserver();
  document.addEventListener('astro:page-load', setupObserver);
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .scroll-fade {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    
    .scroll-fade.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
