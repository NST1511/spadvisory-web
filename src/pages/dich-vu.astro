---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dịch vụ - SP Advisory" description="Giải pháp chuyên sâu về tài chính doanh nghiệp, tư vấn giao dịch, M&A, định giá và tư vấn thuế.">
  <main class="bg-[#FAFAFA] min-h-screen pt-36 pb-20">
    <div class="max-w-[1200px] mx-auto px-6 md:px-12">
      <!-- Header -->
      <header class="max-w-[800px] mb-16 animate-fade-in-up">
        <h1 class="font-serif text-5xl md:text-6xl text-[#0A1628] leading-tight mb-6">Dịch vụ Tư vấn</h1>
        <p class="font-sans text-lg text-[#0A1628]/70 leading-relaxed">
          Cung cấp các giải pháp chuyên sâu trong lĩnh vực tài chính doanh nghiệp, tư vấn giao dịch và thuế, được tinh chỉnh theo nhu cầu đặc thù của từng khách hàng.
        </p>
      </header>

      <!-- Mini-nav -->
      <nav class="mb-20 border-b border-[#0A1628]/10 pb-5">
        <ul class="flex flex-wrap gap-x-2 gap-y-2 items-center">
          <li><a href="#tai-chinh-doanh-nghiep" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Tài chính DN</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#huy-dong-von-ma" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Huy động vốn & M&A</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#dinh-gia-tham-dinh" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Định giá & Thẩm định</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#tai-cau-truc" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Tái cấu trúc</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#tu-van-thue" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Tư vấn Thuế</a></li>
        </ul>
      </nav>

      <!-- Services Clusters -->
      <div class="space-y-32">
        
        <!-- Cluster 1 -->
        <section id="tai-chinh-doanh-nghiep" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            I. Dịch vụ Tài chính Doanh nghiệp
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Tài chính Doanh nghiệp</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Corporate Finance Advisory</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi:</strong>
                  Chiến lược tài chính, Cơ cấu vốn, Đánh giá hiệu quả đầu tư, Quản trị vốn lưu động
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm:</strong>
                  Báo cáo chiến lược tài chính, Báo cáo rà soát tài chính DN, Đề xuất cơ cấu vốn tối ưu
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Giám đốc Tài chính</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">CFO Advisory</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi:</strong>
                  Dịch vụ CFO thuê ngoài (Virtual CFO), Ngân sách, Kế hoạch tài chính, Quản trị dòng tiền, Nguồn vốn và ngân quỹ, Báo cáo quản trị
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm:</strong>
                  Mô hình Ngân sách, Báo cáo Quản trị, Dự báo dòng tiền, Quy chế tài chính
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Xây dựng Mô hình Tài chính</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Financial Modelling</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi:</strong>
                  Lập mô hình tài chính tích hợp, Mô hình định giá DN, Mô hình tài trợ dự án, Phân tích kịch bản và độ nhạy
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm:</strong>
                  Mô hình tài chính phục vụ giao dịch, Mô hình Định giá, Mô hình Dự báo & Kế hoạch tài chính, Mô hình hỗ trợ ra quyết định đầu tư
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 2 -->
        <section id="huy-dong-von-ma" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            II. Tư vấn Huy động vốn và M&A
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-4xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Huy động vốn</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Fund Raising Advisory</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi:</strong>
                  Huy động vốn cổ phần, Huy động vốn vay, Chuẩn bị DN trước khi gọi vốn, Hồ sơ giới thiệu DN (IM), Thiết kế Pitch Deck, Tư vấn cơ cấu vốn, Kết nối nhà đầu tư
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm:</strong>
                  Information Memorandum, Pitch Deck, Mô hình tài chính tối ưu, Danh sách NĐT tiềm năng, Chiến lược huy động vốn
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Mua bán & Sáp nhập</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">M&A Advisory</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi:</strong>
                  Tư vấn bên mua (Buy-side), Tư vấn bên bán (Sell-side), Thiết kế cấu trúc giao dịch, Hỗ trợ đàm phán, Quản lý toàn bộ quá trình giao dịch
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm:</strong>
                  Chiến lược giao dịch, Danh sách NĐT/mục tiêu M&A, Cấu trúc giao dịch, Hỗ trợ hoàn tất giao dịch (Closing)
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 3 -->
        <section id="dinh-gia-tham-dinh" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            III. Định giá & Thẩm định
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-4xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Định giá Doanh nghiệp</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Business Valuation</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi:</strong>
                  Định giá giá trị DN (EV), Định giá khoản đầu tư, Định giá từng chi nhánh tài chính DN
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm:</strong>
                  Báo cáo định giá, Phân tích DCF, Phân tích theo phương pháp so sánh thị trường (Multiples), Phân tích NAV
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Thẩm định Tài chính</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Financial Due Diligence</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi:</strong>
                  Phân tích chất lượng lợi nhuận (Quality of Earnings), Vốn lưu động, Dòng tiền, Cấu trúc vay nợ, Đánh giá rủi ro tài chính tổng thể
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm:</strong>
                  Báo cáo Thẩm định tài chính, Phân tích rủi ro tài chính, EBITDA sau điều chỉnh (normalized EBITDA)
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 4 -->
        <section id="tai-cau-truc" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            IV. Tư vấn Tái cấu trúc
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-2xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Tái cấu trúc Doanh nghiệp</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Restructuring</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi:</strong>
                  Tái cấu trúc tài chính, Tái cơ cấu nợ, Chuyển đổi DN, Tối ưu hóa chi phí
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm:</strong>
                  Phương án tái cấu trúc, Kế hoạch quản lý thanh khoản
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 5 -->
        <section id="tu-van-thue" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            V. Tư vấn Thuế
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-2xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tư vấn Thuế</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Tax Advisory</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Phạm vi:</strong>
                  Hoạch định thuế, Rà soát sức khỏe thuế (Tax Health Check), Thẩm định thuế (Tax Due Diligence), Tư vấn thuế giao dịch
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Sản phẩm:</strong>
                  Báo cáo tư vấn thuế, Báo cáo đánh giá rủi ro thuế, Chiến lược tối ưu thuế
                </div>
              </div>
            </div>
          </div>
        </section>

      </div>
    </div>
  </main>
</BaseLayout>
