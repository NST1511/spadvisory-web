---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Không tìm thấy trang - SP Advisory">
  <main class="bg-[#FAFAFA] min-h-screen flex items-center justify-center pt-20">
    <div class="text-center px-6 animate-fade-in-up">
      <h1 class="font-serif text-8xl md:text-9xl text-[#0A1628] mb-4">404</h1>
      <p class="font-sans text-xl text-[#0A1628]/70 mb-10 font-light">
        Trang bạn tìm kiếm không tồn tại
      </p>
      <div class="w-16 h-[1px] bg-[#C5A55A] mx-auto mb-10"></div>
      <a href="/" class="inline-block px-8 py-4 border border-[#0A1628] text-[#0A1628] font-sans text-sm tracking-widest uppercase hover:bg-[#0A1628] hover:text-white transition-colors duration-300 shadow-sm">
        Về trang chủ
      </a>
    </div>
  </main>
</BaseLayout>
