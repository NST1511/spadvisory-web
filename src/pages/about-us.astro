---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="About Us — SP Advisory" 
  description="Senior advisory team from Big Four and global investment banks. Boutique advisory — Precision. Privacy. Performance."
  lang="en"
>
  <main class="bg-[#FAFAFA] min-h-screen pt-36 pb-20">
    <div class="max-w-[1200px] mx-auto px-6 md:px-12">
      <!-- Story Section -->
      <section class="max-w-[800px] mb-24 animate-fade-in-up">
        <h1 class="font-serif text-5xl md:text-6xl text-[#0A1628] leading-tight mb-10">Our Story</h1>
        <div class="space-y-6 font-sans text-lg text-[#0A1628]/80 leading-relaxed font-light">
          <p>
            SP Advisory is an independent advisory firm specializing in corporate finance and transaction execution, founded by seasoned leaders from Big Four advisory firms, international banks, and premier financial institutions.
          </p>
          <p>
            Operating under a <em class="text-[#0A1628] not-italic font-medium">boutique advisory model</em>, we emphasize practical, high-conviction execution. Every engagement is directly led and delivered by senior partners, ensuring unmatched responsiveness, rigor, and strategic impact for our clients.
          </p>
          <div class="pt-4">
            <strong class="font-serif text-2xl text-[#C5A55A] font-normal block mb-2">Our Distinct Edge</strong>
            SP Advisory uniquely integrates transaction execution, corporate finance, and strategic tax advisory into a unified multidisciplinary platform — delivering a comprehensive, 360-degree perspective on complex corporate decisions.
          </div>
        </div>
      </section>

      <!-- Core Values -->
      <section class="mb-32">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="border-t-2 border-[#C5A55A] pt-6">
            <h3 class="font-serif text-2xl text-[#0A1628] mb-3">Precision</h3>
            <p class="font-sans text-[#0A1628]/70 text-sm">Uncompromising accuracy and depth in all financial analytics and valuations.</p>
          </div>
          <div class="border-t-2 border-[#C5A55A] pt-6">
            <h3 class="font-serif text-2xl text-[#0A1628] mb-3">Privacy</h3>
            <p class="font-sans text-[#0A1628]/70 text-sm">Absolute confidentiality and discretion protecting client interests and transactions.</p>
          </div>
          <div class="border-t-2 border-[#C5A55A] pt-6">
            <h3 class="font-serif text-2xl text-[#0A1628] mb-3">Performance</h3>
            <p class="font-sans text-[#0A1628]/70 text-sm">Laser-focused on tangible, measurable, and long-term value creation.</p>
          </div>
        </div>
      </section>

      <!-- Team Section -->
      <section>
        <h2 class="font-serif text-4xl text-[#0A1628] mb-16 text-center">Leadership Team</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">

          <div class="bg-white p-8 border border-[#0A1628]/5 shadow-sm flex flex-col sm:flex-row gap-8 items-start">
            <img src="/images/team/hung.png" alt="Hung Nguyen" class="flex-shrink-0 w-28 h-36 object-cover object-top" width="245" height="296" />
            <div>
              <h3 class="font-serif text-2xl text-[#0A1628] mb-1">Hung Nguyen</h3>
              <p class="font-sans text-sm text-[#C5A55A] mb-4">Managing Director<br/>Corporate Finance, M&amp;A and Financial Due Diligence</p>
              <ul class="font-sans text-sm text-[#0A1628]/70 space-y-2 list-disc list-inside">
                <li>15+ years in audit, investment banking and M&amp;A advisory</li>
                <li>Former Managing Director, Hyperion Investment Advisory</li>
                <li>Senior roles at KPMG Deal Advisory and Techcombank</li>
                <li>Led transactions of up to USD 300 million</li>
                <li>MBA, Texas Christian University; MSc Business Analytics, UT Dallas</li>
              </ul>
            </div>
          </div>

          <div class="bg-white p-8 border border-[#0A1628]/5 shadow-sm flex flex-col sm:flex-row gap-8 items-start">
            <div class="flex-shrink-0 w-28 h-36 bg-[#0A1628] text-[#C5A55A] flex items-center justify-center font-serif text-3xl">TB</div>
            <div>
              <h3 class="font-serif text-2xl text-[#0A1628] mb-1">Tuan Bui, CPA</h3>
              <p class="font-sans text-sm text-[#C5A55A] mb-4">Managing Partner<br/>Tax and CFO Advisory</p>
              <ul class="font-sans text-sm text-[#0A1628]/70 space-y-2 list-disc list-inside">
                <li>17+ years in audit, tax, accounting and finance</li>
                <li>Tax Senior Manager at a Big Four firm</li>
                <li>Former Finance Manager and Chief Accountant at a leading global apparel company</li>
                <li>Fellow of CPA Australia (FCPA)</li>
                <li>Vietnam Tax Agent and Chief Accountant certifications</li>
              </ul>
            </div>
          </div>

          <div class="bg-white p-8 border border-[#0A1628]/5 shadow-sm flex flex-col sm:flex-row gap-8 items-start">
            <img src="/images/team/tung.jpg" alt="Tung Nguyen" class="flex-shrink-0 w-28 h-36 object-cover object-top" width="800" height="958" />
            <div>
              <h3 class="font-serif text-2xl text-[#0A1628] mb-1">Tung Nguyen, CFA</h3>
              <p class="font-sans text-sm text-[#C5A55A] mb-4">Valuation and Financial Modelling Lead</p>
              <ul class="font-sans text-sm text-[#0A1628]/70 space-y-2 list-disc list-inside">
                <li>10+ years in equity and deal advisory</li>
                <li>Former senior consultant, KPMG Deal Advisory</li>
                <li>Analyst roles at Techcombank and FPT Securities</li>
                <li>CFA Charterholder</li>
                <li>MSc Banking and Finance, University of Leicester; MSc Data Science, Trier University</li>
              </ul>
            </div>
          </div>

          <div class="bg-white p-8 border border-[#0A1628]/5 shadow-sm flex flex-col sm:flex-row gap-8 items-start">
            <div class="flex-shrink-0 w-28 h-36 bg-[#0A1628] text-[#C5A55A] flex items-center justify-center font-serif text-3xl">NL</div>
            <div>
              <h3 class="font-serif text-2xl text-[#0A1628] mb-1">Ninh Luu</h3>
              <p class="font-sans text-sm text-[#C5A55A] mb-4">Managing Partner<br/>Client Engagement</p>
              <ul class="font-sans text-sm text-[#0A1628]/70 space-y-2 list-disc list-inside">
                <li>20+ years in banking and private wealth</li>
                <li>Former Head of Private Banking Sales, North, at a leading Vietnamese commercial bank</li>
                <li>Former ANZ Priority Banking Leader</li>
                <li>Corporate banking, fundraising and investor relations</li>
              </ul>
            </div>
          </div>

        </div>
      </section>
    </div>
  </main>
</BaseLayout>
