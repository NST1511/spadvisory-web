---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
---

<BaseLayout 
  title="S-Partners Advisory Company" 
  description="Boutique advisory — Precision. Privacy. Performance."
  transparentHeader={true}
  lang="en"
>
  <!-- Section 1: Hero -->
  <Hero lang="en" />

  <!-- Section 2: Services Overview -->
  <section class="py-24 md:py-32 px-6 md:px-12 max-w-[1200px] mx-auto scroll-fade">
    <h2 class="text-center text-[#0A1628] font-serif text-2xl md:text-3xl tracking-[0.15em] mb-16">
      TAX • FINANCE • M&A
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <ServiceCard 
        title="Tax Advisory"
        description="Comprehensive tax solutions for enterprises, optimizing tax efficiency and ensuring full regulatory compliance."
        href="/en/services#tu-van-thue"
        lang="en"
      />
      <ServiceCard 
        title="Corporate Finance"
        description="Valuation, financial restructuring, and strategic advisory to accelerate sustainable corporate growth."
        href="/en/services#tai-chinh-doanh-nghiep"
        lang="en"
      />
      <ServiceCard 
        title="M&A Advisory"
        description="End-to-end mergers and acquisitions advisory, from origination to flawless transaction closing."
        href="/en/services#huy-dong-von-ma"
        lang="en"
      />
    </div>
  </section>

  <!-- Section 3: Values -->
  <section class="py-24 md:py-32 px-6 md:px-12 bg-[#FAFAFA] scroll-fade">
    <div class="max-w-[1200px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-8 text-center">
        <div class="flex flex-col items-center">
          <h3 class="font-serif text-[#C5A55A] text-3xl mb-4 italic">Precision</h3>
          <p class="font-sans text-gray-600 max-w-xs mx-auto">Absolute rigor in financial modeling, valuation, and risk evaluation.</p>
        </div>
        <div class="flex flex-col items-center">
          <h3 class="font-serif text-[#C5A55A] text-3xl mb-4 italic">Privacy</h3>
          <p class="font-sans text-gray-600 max-w-xs mx-auto">Client confidentiality and deal integrity remain our highest priority.</p>
        </div>
        <div class="flex flex-col items-center">
          <h3 class="font-serif text-[#C5A55A] text-3xl mb-4 italic">Performance</h3>
          <p class="font-sans text-gray-600 max-w-xs mx-auto">Unwavering focus on delivering measurable, high-impact transaction outcomes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4: CTA -->
  <section id="contact" class="py-32 px-6 md:px-12 text-center scroll-fade">
    <div class="max-w-[800px] mx-auto flex flex-col items-center">
      <h2 class="text-[#0A1628] font-serif text-3xl md:text-4xl mb-10">
        Unlock Strategic Value with S-Partners
      </h2>
      <a 
        href="/en/contact" 
        class="inline-block border border-[#0A1628] text-[#0A1628] uppercase text-[13px] tracking-[0.08em] px-10 py-4 transition-all duration-300 hover:bg-[#0A1628] hover:text-[#FAFAFA]"
      >
        Contact Our Advisors
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Intersection Observer for scroll animations
  const setupObserver = () => {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll('.scroll-fade');
    elements.forEach(el => observer.observe(el));
  };

  // Run on load and after view transitions
  setupObserver();
  document.addEventListener('astro:page-load', setupObserver);
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .scroll-fade {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    
    .scroll-fade.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
