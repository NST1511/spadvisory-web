---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Advisory Services — SP Advisory" 
  description="Specialized solutions in corporate finance, transaction advisory, M&A, business valuation, and tax advisory."
  lang="en"
>
  <main class="bg-[#FAFAFA] min-h-screen pt-36 pb-20">
    <div class="max-w-[1200px] mx-auto px-6 md:px-12">
      <!-- Header -->
      <header class="max-w-[800px] mb-16 animate-fade-in-up">
        <h1 class="font-serif text-5xl md:text-6xl text-[#0A1628] leading-tight mb-6">Advisory Services</h1>
        <p class="font-sans text-lg text-[#0A1628]/70 leading-relaxed">
          Providing high-impact, tailored advisory solutions in corporate finance, transaction execution, and tax strategy to meet the unique objectives of every client.
        </p>
      </header>

      <!-- Mini-nav -->
      <nav class="mb-20 border-b border-[#0A1628]/10 pb-5">
        <ul class="flex flex-wrap gap-x-2 gap-y-2 items-center">
          <li><a href="#tai-chinh-doanh-nghiep" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Corporate Finance</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#huy-dong-von-ma" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Fund Raising & M&A</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#dinh-gia-tham-dinh" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Valuation & Due Diligence</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#tai-cau-truc" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Restructuring</a></li>
          <li class="text-[#C5A55A] text-xs select-none">◆</li>
          <li><a href="#tu-van-thue" class="font-sans text-xs tracking-[0.1em] text-[#0A1628]/50 hover:text-[#C5A55A] transition-colors uppercase">Tax Advisory</a></li>
        </ul>
      </nav>

      <!-- Services Clusters -->
      <div class="space-y-32">
        
        <!-- Cluster 1 -->
        <section id="tai-chinh-doanh-nghiep" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            I. Corporate Finance Advisory
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Corporate Finance Advisory</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Strategic Growth & Capital</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Scope:</strong>
                  Financial strategy, capital structure optimization, investment appraisal, working capital management
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Deliverables:</strong>
                  Financial strategy roadmap, corporate financial review reports, optimal capital structure proposals
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">CFO Advisory</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Executive Leadership</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Scope:</strong>
                  Virtual CFO / Interim CFO services, budgeting, financial planning, liquidity management, treasury & management reporting
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Deliverables:</strong>
                  Budget models, management reporting packs, cash flow forecasts, financial governance frameworks
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Financial Modelling</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Dynamic Decision Support</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Scope:</strong>
                  Integrated 3-statement financial models, valuation models, project finance models, scenario & sensitivity analysis
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Deliverables:</strong>
                  Transaction-ready financial models, valuation tools, long-term financial forecasts, investment decision models
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 2 -->
        <section id="huy-dong-von-ma" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            II. Fund Raising & M&A Advisory
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-4xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Fund Raising Advisory</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Equity & Debt Financing</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Scope:</strong>
                  Equity financing, debt advisory, pre-deal business readiness, Information Memorandum (IM), pitch deck development, capital structuring, investor roadshows
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Deliverables:</strong>
                  Information Memorandum, investor pitch decks, optimized financial models, qualified investor lists, fund raising strategy
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">M&A Advisory</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Transaction Execution</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Scope:</strong>
                  Buy-side advisory, sell-side advisory, deal structuring, commercial negotiation support, end-to-end transaction management
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Deliverables:</strong>
                  M&A execution strategy, target/investor screening, transaction structural blueprint, completion & closing support
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 3 -->
        <section id="dinh-gia-tham-dinh" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            III. Valuation & Due Diligence
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-4xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Business Valuation</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Asset & Enterprise Appraisal</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Scope:</strong>
                  Enterprise Value (EV), equity valuation, investment appraisal, business division / portfolio asset valuation
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Deliverables:</strong>
                  Independent valuation reports, DCF valuation models, trading & transaction multiples analysis, NAV appraisal
                </div>
              </div>
            </div>

            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Financial Due Diligence</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Quality of Earnings & Risks</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Scope:</strong>
                  Quality of Earnings (QoE) analysis, working capital peg, cash flow sustainability, net debt and debt-like items analysis, holistic financial risk identification
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Deliverables:</strong>
                  Financial Due Diligence reports, financial risk matrix, normalized EBITDA computation
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 4 -->
        <section id="tai-cau-truc" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            IV. Restructuring
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-2xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Corporate Restructuring</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Financial & Operational Turnaround</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Scope:</strong>
                  Financial restructuring, debt workout & renegotiation, business transformation, cost optimization strategies
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Deliverables:</strong>
                  Restructuring roadmap, liquidity turnaround & contingency plans
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Cluster 5 -->
        <section id="tu-van-thue" class="scroll-mt-32">
          <h2 class="font-serif text-3xl text-[#C5A55A] mb-12 flex items-center">
            <span class="w-12 h-[1px] bg-[#C5A55A] mr-4 block"></span>
            V. Tax Advisory
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:max-w-2xl">
            <div class="bg-white p-8 border border-[#0A1628]/5 border-b-[3px] border-b-[#C5A55A] shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col h-full">
              <h3 class="font-serif text-2xl text-[#0A1628] mb-2">Tax Advisory</h3>
              <span class="font-sans text-xs text-[#0A1628]/50 uppercase tracking-widest mb-6 block">Strategic Tax Planning</span>
              <div class="space-y-4 font-sans text-sm text-[#0A1628]/80 flex-grow">
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Scope:</strong>
                  Tax planning, Tax Health Check, Tax Due Diligence, transaction tax structuring
                </div>
                <div>
                  <strong class="block text-[#0A1628] mb-1 font-medium">Deliverables:</strong>
                  Tax advisory memorandums, tax risk assessment reports, tax optimization blueprints
                </div>
              </div>
            </div>
          </div>
        </section>

      </div>
    </div>
  </main>
</BaseLayout>
