---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact Us — SP Advisory" 
  description="Contact S-Partners Advisory Company. Office address, email, phone, and direct contact with our senior advisory team."
  lang="en"
>
  <main class="bg-[#FAFAFA] min-h-screen pt-32 pb-20 flex flex-col items-center justify-center">
    <div class="max-w-[1200px] w-full mx-auto px-6 md:px-12">
      <div class="flex flex-col md:flex-row gap-16 md:gap-24 animate-fade-in-up">
        
        <!-- Left Side: Heading -->
        <div class="flex-1 md:pr-12 md:border-r border-[#0A1628]/10">
          <h1 class="font-serif text-6xl md:text-7xl text-[#0A1628] leading-tight mb-6">Contact Us</h1>
          <p class="font-sans text-lg text-[#0A1628]/70 leading-relaxed font-light">
            We are ready to listen and partner with you on your enterprise's strategic growth journey. Connect with SP Advisory via the contact details below.
          </p>
          <div class="mt-12 h-[1px] w-24 bg-[#C5A55A]"></div>
        </div>

        <!-- Right Side: Contact Info -->
        <div class="flex-1 flex flex-col justify-center">
          <ul class="space-y-10 font-sans">
            <!-- Address -->
            <li class="flex items-start">
              <div class="mt-1 mr-4 text-[#C5A55A]">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              </div>
              <div>
                <span class="block text-xs uppercase tracking-widest text-[#0A1628]/50 mb-1">Office</span>
                <span class="text-[#0A1628] text-base leading-relaxed">
                  BT2D-19, Mo Lao Urban Area<br/>
                  Ha Dong District, Hanoi, Vietnam
                </span>
              </div>
            </li>
            
            <!-- Email -->
            <li class="flex items-start">
              <div class="mt-1 mr-4 text-[#C5A55A]">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </div>
              <div>
                <span class="block text-xs uppercase tracking-widest text-[#0A1628]/50 mb-1">General Inquiries</span>
                <a href="mailto:admin@spadvisory.com.vn" class="text-[#0A1628] text-base hover:text-[#C5A55A] transition-colors duration-200 block mb-3">admin@spadvisory.com.vn</a>
                
                <span class="block text-xs uppercase tracking-widest text-[#0A1628]/50 mb-1 mt-4">Managing Partners</span>
                <ul class="text-[#0A1628] text-sm space-y-1">
                  <li><a href="mailto:hung.nguyen@spadvisory.com.vn" class="hover:text-[#C5A55A] transition-colors duration-200">hung.nguyen@spadvisory.com.vn</a></li>
                  <li><a href="mailto:tuan.bui@spadvisory.com.vn" class="hover:text-[#C5A55A] transition-colors duration-200">tuan.bui@spadvisory.com.vn</a></li>
                  <li><a href="mailto:tung.nguyen@spadvisory.com.vn" class="hover:text-[#C5A55A] transition-colors duration-200">tung.nguyen@spadvisory.com.vn</a></li>
                  <li><a href="mailto:ninh.luu@spadvisory.com.vn" class="hover:text-[#C5A55A] transition-colors duration-200">ninh.luu@spadvisory.com.vn</a></li>
                </ul>
              </div>
            </li>

            <!-- Phone -->
            <li class="flex items-start">
              <div class="mt-1 mr-4 text-[#C5A55A]">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <span class="block text-xs uppercase tracking-widest text-[#0A1628]/50 mb-1">Direct Line</span>
                <a href="tel:+84964008304" class="text-[#0A1628] text-base hover:text-[#C5A55A] transition-colors duration-200">(+84) 964 008 304</a>
              </div>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>
