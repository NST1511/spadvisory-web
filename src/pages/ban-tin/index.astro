---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterCard from '../../components/NewsletterCard.astro';
import { getCollection } from 'astro:content';

const allNewsletters = await getCollection('newsletters', ({ data }) => !data.draft);
const sorted = allNewsletters.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Bản tin — SP Advisory" description="Phân tích và nhận định thị trường từ đội ngũ S-Partners Advisory.">
  <section class="pt-36 pb-24 md:pb-32">
    <div class="max-w-[1200px] mx-auto px-6 md:px-12">
      <!-- Heading -->
      <div class="mb-16 md:mb-24">
        <h1 class="font-serif text-4xl md:text-5xl text-[#0A1628] mb-4">Bản tin</h1>
        <p class="font-sans text-lg text-[#6B7280] max-w-[600px]">
          Phân tích và nhận định thị trường từ đội ngũ S-Partners Advisory.
        </p>
        <div class="w-16 h-[2px] bg-[#C5A55A] mt-6"></div>
      </div>

      <!-- Newsletter grid -->
      {sorted.length > 0 ? (
        <div class="grid gap-8 md:gap-10">
          {sorted.map((newsletter) => (
            <NewsletterCard
              title={newsletter.data.title}
              date={newsletter.data.date}
              description={newsletter.data.description}
              type={newsletter.data.type}
              slug={newsletter.id}
            />
          ))}
        </div>
      ) : (
        <p class="text-[#6B7280] font-sans text-lg">Chưa có bản tin nào.</p>
      )}
    </div>
  </section>
</BaseLayout>
