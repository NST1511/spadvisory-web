---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PasswordGate from '../components/PasswordGate.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  transparentHeader?: boolean;
  lang?: 'en' | 'vi';
}

const { 
  title, 
  description, 
  ogImage = '/images/og-default.jpg',
  transparentHeader = false,
  lang = 'en'
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | S-Partners Advisory Company</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />
    
    <!-- Canonical URL placeholder -->
    <link rel="canonical" href={Astro.url} />
    
    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts preconnect + load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="flex flex-col min-h-screen relative">
    <!-- Private Preview Password Gate -->
    <PasswordGate lang={lang} />

    <Header transparent={transparentHeader} lang={lang} />
    
    <main class="flex-grow">
      <slot />
    </main>
    
    <Footer lang={lang} />
  </body>
</html>
